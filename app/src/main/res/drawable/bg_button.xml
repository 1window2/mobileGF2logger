<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/control_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_variant" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface_pressed" />
                    <stroke android:width="1dp" android:color="@color/outline_strong" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="@color/surface" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
