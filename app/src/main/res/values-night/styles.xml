<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textViewStyle">@style/Widget.GF2.TextView</item>
        <item name="android:buttonStyle">@style/Widget.GF2.Button</item>
        <item name="android:editTextStyle">@style/Widget.GF2.EditText</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
