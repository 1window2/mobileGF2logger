    <string name="onboarding_main_description">Capture communications from the GIRLS\' FRONTLINE 2: EXILIUM client and see packet collection progress at a glance.</string>
    <string name="onboarding_main_feature_1">Prepare capture keeps running until you stop it.</string>
    <string name="onboarding_main_feature_2">One-time Capture checks Platoon identity, Members, Activity, and Updates, then stops automatically.</string>
    <string name="onboarding_main_feature_3">Recent and saved packet history is stored locally.</string>
