<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/GF2BaseTheme" />

    <style name="GF2BaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textViewStyle">@style/Widget.GF2.TextView</item>
        <item name="android:editTextStyle">@style/Widget.GF2.EditText</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:alertDialogTheme">@style/GF2DialogTheme</item>
        <item name="android:datePickerDialogTheme">@style/GF2PickerTheme</item>
        <item name="android:timePickerDialogTheme">@style/GF2PickerTheme</item>
    </style>

    <!-- Pure black from the first frame, so entering standby never flashes the app background. -->
    <style name="GF2StandbyTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="GF2DialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="Widget.GF2.TextView" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
    </style>


    <style name="Widget.GF2.EditText" parent="@android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Pickers use the darker accent so selected dates and buttons stay legible. -->
    <style name="GF2PickerTheme" parent="android:style/Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>
</resources>
